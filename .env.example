# 别放进项目目录！复制到 <作业根>/.xuexitong_mcp/.env（默认 D:\学习通作业\.xuexitong_mcp\.env）
# 优先级：进程环境变量（MCP env 注入）> 项目根 .env > 本文件。三个都没有则工具报缺凭据。
# 账号密码（必填其一）
XUEXITONG_USERNAME=
XUEXITONG_PASSWORD=
# cookie（可选，优先级高于账号密码；格式 a=1; b=2 或每行一条）
XUEXITONG_COOKIE=
# cookie 落盘位置（可选，默认 <状态根>/cookies.json，即 <作业根>/.xuexitong_mcp/cookies.json）
XUEXITONG_STATE_PATH=
# 设为 1 才放宽 TLS 校验（默认严格校验，不学参考实现的 verify=False）
XUEXITONG_INSECURE=
